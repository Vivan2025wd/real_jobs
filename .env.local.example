# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...      # server-only; never expose

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── AWS S3 ───
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
S3_PRIVATE_BUCKET=hireloop-resumes
S3_PUBLIC_BUCKET=hireloop-assets
CLOUDFRONT_PUBLIC_DOMAIN=            # optional; leave blank to skip

# ─── PayHere (sandbox) ───
PAYHERE_MERCHANT_ID=1210000
PAYHERE_MERCHANT_SECRET=...
PAYHERE_MODE=sandbox                 # 'sandbox' or 'production'

# ─── Resend ───
RESEND_API_KEY=re_...
EMAIL_FROM=HireLoop <onboarding@resend.dev>

# ─── Cron ───
CRON_SECRET=                          # openssl rand -base64 32
